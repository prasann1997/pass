rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function allowedThemes() {
      // Extend this list when adding new supported themes.
      return [
        'classic',
        'holidays',
        'birthday',
        'halloween',
        'christmas',
        'newyear',
        'valentines',
        'sports',
        'music',
        'movies'
      ];
    }

    function gameAllowedKeys() {
      return [
        'createdAt', 'hostUid', 'currentWord', 'wordUpdatedAt', 'reveal',
        'roundActive', 'solvedByTeamId', 'turnOrder', 'turnIndex',
        'activeTeamId', 'offeredPoints', 'attemptedTeamIds',
        'turnStartedAt', 'turnDurationMs', 'turnPaused', 'pausedRemainingMs',
        'turnEndsAt', 'theme', 'updatedBy'
      ];
    }

    function validGameData(data) {
      return data.keys().hasOnly(gameAllowedKeys())
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('hostUid' in data) || data.hostUid is string || data.hostUid == null)
        && (!('currentWord' in data) || data.currentWord is string)
        && (!('wordUpdatedAt' in data) || data.wordUpdatedAt is timestamp)
        && (!('reveal' in data) || data.reveal is bool)
        && (!('roundActive' in data) || data.roundActive is bool)
        && (!('solvedByTeamId' in data) || data.solvedByTeamId is string || data.solvedByTeamId == null)
        && (!('turnOrder' in data) || (data.turnOrder is list && data.turnOrder.all(t, t is string)))
        && (!('turnIndex' in data) || data.turnIndex is int)
        && (!('activeTeamId' in data) || data.activeTeamId is string || data.activeTeamId == null)
        && (!('offeredPoints' in data) || data.offeredPoints is int)
        && (!('attemptedTeamIds' in data) || (data.attemptedTeamIds is list && data.attemptedTeamIds.all(t, t is string)))
        && (!('turnStartedAt' in data) || data.turnStartedAt is timestamp || data.turnStartedAt == null)
        && (!('turnDurationMs' in data) || data.turnDurationMs is int || data.turnDurationMs == null)
        && (!('turnPaused' in data) || data.turnPaused is bool)
        && (!('pausedRemainingMs' in data) || data.pausedRemainingMs is int || data.pausedRemainingMs == null)
        && (!('turnEndsAt' in data) || data.turnEndsAt is timestamp || data.turnEndsAt == null)
        && (!('theme' in data) || (data.theme is string && allowedThemes().hasAny([data.theme])))
        && (!('updatedBy' in data) || data.updatedBy is string || data.updatedBy == null);
    }

    function teamAllowedKeys() {
      return ['name', 'score', 'createdAt'];
    }

    function validTeamData(data) {
      return data.keys().hasOnly(teamAllowedKeys())
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 40
        && data.score is int
        && data.score >= -999
        && data.score <= 999
        && data.createdAt is timestamp;
    }

    match /games/{gameId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && validGameData(request.resource.data);

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(gameAllowedKeys())
        && validGameData(request.resource.data);

      allow delete: if request.auth != null;

      match /teams/{teamId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null && validTeamData(request.resource.data);

        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(teamAllowedKeys())
          && validTeamData(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if request.auth != null;
      }
    }
  }
}
